/* ==========================================================================
   EduOS - Login Screen, Modals & Dialogs
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. ЕКРАН ВХОДУ (LOGIN / WELCOME SCREEN)
   -------------------------------------------------------------------------- */
#login-screen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 50% 30%, #1e293b 0%, #0f172a 60%, #020617 100%);
  background-size: cover;
}

.login-glass-card {
  width: 440px;
  max-width: 90vw;
  padding: 36px 32px;
  border-radius: var(--radius-xl);
  text-align: center;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
}

.login-logo-group {
  margin-bottom: 24px;
}

.login-system-logo {
  filter: drop-shadow(0 6px 14px rgba(2, 132, 199, 0.45));
}

.login-title {
  font-size: 26px;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 10px;
  letter-spacing: -0.5px;
}

.login-subtitle {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: 4px;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
  text-align: left;
}

.login-input-group label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 6px;
}

.login-input {
  width: 100%;
  height: 42px;
  padding: 0 14px;
  background: var(--bg-input);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  font-size: 13.5px;
  transition: all var(--transition-fast);
}

.login-input:focus {
  border-color: var(--border-focus);
  box-shadow: 0 0 14px var(--accent-glow);
  background: var(--bg-surface-active);
}

.login-submit-btn {
  margin-top: 8px;
  height: 44px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--accent-primary), #0284c7);
  color: #ffffff;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
  box-shadow: 0 4px 16px var(--accent-glow);
}

.login-submit-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 22px var(--accent-glow);
}

.login-saved-profiles {
  margin-top: 24px;
  padding-top: 18px;
  border-top: 1px solid var(--border-subtle);
}

.login-saved-profiles h4 {
  font-size: 11.5px;
  color: var(--text-muted);
  margin-bottom: 10px;
  text-align: center;
}

.profiles-chips-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
}

.profile-chip {
  padding: 6px 12px;
  border-radius: var(--radius-xl);
  background: var(--bg-surface);
  color: var(--text-primary);
  font-size: 11.5px;
  cursor: pointer;
  transition: all var(--transition-fast);
  border: 1px solid var(--border-subtle);
}

.profile-chip:hover {
  background: var(--bg-surface-active);
  border-color: var(--border-focus);
}

/* --------------------------------------------------------------------------
   2. МОДАЛЬНІ ВІКНА ТА ДІАЛОГИ (MODALS)
   -------------------------------------------------------------------------- */
.edu-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50000;
}

/* Діалог властивостей файлу */
.properties-modal {
  width: 380px;
  padding: 20px;
}

.prop-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.prop-header h3 {
  font-size: 15px;
  color: var(--text-primary);
}

.prop-close {
  background: transparent;
  color: var(--text-secondary);
  font-size: 16px;
  cursor: pointer;
}

.prop-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 12.5px;
}

.prop-row {
  display: flex;
  justify-content: space-between;
}

.prop-divider {
  border: none;
  border-top: 1px solid var(--border-subtle);
  margin: 10px 0;
}

.prop-attributes-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.prop-check-label {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}

.prop-footer {
  margin-top: 20px;
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}

.prop-btn-ok {
  padding: 6px 16px;
  border-radius: var(--radius-sm);
  background: var(--accent-primary);
  color: #ffffff;
  font-weight: 500;
  cursor: pointer;
}

.prop-btn-cancel {
  padding: 6px 14px;
  border-radius: var(--radius-sm);
  background: var(--bg-surface-hover);
  color: var(--text-primary);
  cursor: pointer;
}

/* Модальне вікно сертифіката */
.certificate-modal-box {
  width: 860px;
  max-width: 95vw;
  background: var(--bg-acrylic-solid);
  border: 1px solid var(--border-highlight);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: 0 30px 70px rgba(0, 0, 0, 0.7);
  display: flex;
  flex-direction: column;
}

.cert-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}

.cert-modal-header h3 {
  font-size: 18px;
}

.cert-modal-close {
  background: transparent;
  color: var(--text-secondary);
  font-size: 18px;
  cursor: pointer;
}

.cert-preview-wrapper {
  background: #2a2a2a;
  padding: 10px;
  border-radius: var(--radius-sm);
  display: flex;
  justify-content: center;
  overflow: hidden;
}

.cert-preview-img {
  width: 100%;
  height: auto;
  max-height: 60vh;
  object-fit: contain;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  border-radius: 4px;
}

.cert-modal-footer {
  margin-top: 16px;
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

.cert-btn-download {
  padding: 8px 18px;
  border-radius: var(--radius-sm);
  background: var(--color-success);
  color: #ffffff;
  font-weight: 600;
  cursor: pointer;
}

.cert-btn-print {
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  background: var(--accent-primary);
  color: #ffffff;
  font-weight: 500;
  cursor: pointer;
}

.cert-btn-close-bottom {
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  background: var(--bg-surface-hover);
  color: var(--text-primary);
  cursor: pointer;
}

/* --------------------------------------------------------------------------
   3. УНІВЕРСАЛЬНІ СИСТЕМНІ ДІАЛОГОВІ ВІКНА (FLUENT UI DIALOGS)
   -------------------------------------------------------------------------- */
@keyframes modalFadeIn {
  from { opacity: 0; transform: scale(0.96) translateY(6px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes modalOverlayIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes modalOverlayOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes flyoutSlideUp {
  from { opacity: 0; transform: translateY(10px) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.fluent-modal-fadeIn {
  animation: modalOverlayIn 0.16s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.fluent-modal-fadeOut {
  animation: modalOverlayOut 0.14s ease-out forwards;
}

.fluent-dialog {
  background: var(--bg-acrylic-solid);
  border: 1px solid var(--border-highlight);
  border-radius: var(--radius-lg);
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 2px 10px rgba(0, 0, 0, 0.25);
  min-width: 380px;
  max-width: 92vw;
  animation: modalFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.fluent-dialog-alert,
.fluent-dialog-confirm {
  width: 440px;
}

.fluent-dialog-prompt,
.fluent-dialog-newfolder,
.fluent-dialog-rename {
  width: 460px;
}

.fluent-dialog-savefile {
  width: 520px;
}

.fluent-dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  border-bottom: 1px solid var(--border-subtle);
  background: rgba(255, 255, 255, 0.02);
}

.fluent-dialog-title-group {
  display: flex;
  align-items: center;
  gap: 10px;
}

.fluent-dialog-icon {
  font-size: 19px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fluent-dialog-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0;
}

.fluent-dialog-close {
  background: transparent;
  border: none;
  color: var(--text-secondary);
  font-size: 14px;
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.fluent-dialog-close:hover {
  background: var(--bg-surface-hover);
  color: var(--text-primary);
}

.fluent-dialog-body {
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  color: var(--text-primary);
  font-size: 13px;
}

.fluent-dialog-message {
  line-height: 1.55;
  white-space: pre-line;
  color: var(--text-primary);
  font-size: 13.5px;
}

.fluent-dialog-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.fluent-dialog-label {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-secondary);
}

.fluent-dialog-input,
.fluent-dialog-select {
  width: 100%;
  height: 38px;
  padding: 0 12px;
  background: var(--bg-input);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  font-size: 13px;
  transition: all var(--transition-fast);
}

.fluent-dialog-input:focus,
.fluent-dialog-select:focus {
  outline: none;
  border-color: var(--border-focus);
  box-shadow: 0 0 12px var(--accent-glow);
  background: var(--bg-surface-active);
}

.fluent-dialog-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.fluent-dialog-input-wrapper .fluent-dialog-input {
  padding-left: 36px;
}

.fluent-dialog-input-icon {
  position: absolute;
  left: 10px;
  font-size: 16px;
  pointer-events: none;
}

.fluent-dialog-input-ext-group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.fluent-dialog-ext-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 10px;
  height: 38px;
  border-radius: var(--radius-md);
  background: var(--bg-surface-hover);
  border: 1px solid var(--border-subtle);
  color: var(--accent-primary);
  font-size: 12.5px;
  font-weight: 600;
  user-select: none;
}

.fluent-dialog-hint {
  font-size: 11px;
  color: var(--text-muted);
}

.fluent-save-info-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  background: rgba(2, 132, 199, 0.08);
  border: 1px solid rgba(2, 132, 199, 0.2);
}

.fluent-save-info-icon {
  font-size: 24px;
}

.fluent-save-info-meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-size: 11.5px;
  color: var(--text-secondary);
}

.fluent-dialog-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10px;
  padding: 14px 20px;
  border-top: 1px solid var(--border-subtle);
  background: rgba(0, 0, 0, 0.15);
}

.fluent-dialog-btn {
  height: 36px;
  padding: 0 18px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  border: none;
  transition: all var(--transition-fast);
}

.fluent-dialog-btn-primary {
  background: var(--accent-primary);
  color: #ffffff;
  box-shadow: 0 2px 10px var(--accent-glow);
}

.fluent-dialog-btn-primary:hover {
  background: #0284c7;
  box-shadow: 0 4px 16px var(--accent-glow);
  transform: translateY(-1px);
}

.fluent-dialog-btn-secondary {
  background: var(--bg-surface-hover);
  color: var(--text-primary);
  border: 1px solid var(--border-subtle);
}

.fluent-dialog-btn-secondary:hover {
  background: var(--bg-surface-active);
  border-color: var(--border-highlight);
}

.fluent-dialog-btn-danger {
  background: #dc2626;
  color: #ffffff;
  box-shadow: 0 2px 8px rgba(220, 38, 38, 0.4);
}

.fluent-dialog-btn-danger:hover {
  background: #ef4444;
  transform: translateY(-1px);
}

/* --------------------------------------------------------------------------
   4. МОВНИЙ ПЕРЕМИКАЧ (INPUT LANGUAGE FLYOUT & HUD)
   -------------------------------------------------------------------------- */
.edu-lang-flyout {
  position: fixed;
  bottom: 54px;
  right: 12px;
  width: 310px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-highlight);
  background: var(--bg-acrylic-solid);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
  z-index: 55000;
  padding: 14px;
  display: none;
  flex-direction: column;
  gap: 10px;
  animation: flyoutSlideUp 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.edu-lang-flyout.open {
  display: flex;
}

.lang-flyout-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.lang-flyout-header {
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border-subtle);
}

.lang-flyout-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lang-flyout-title {
  font-size: 11.5px;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.lang-flyout-shortcut-badge {
  font-size: 11px;
  font-weight: 700;
  color: var(--accent-primary);
  background: rgba(2, 132, 199, 0.16);
  border: 1px solid rgba(2, 132, 199, 0.35);
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  letter-spacing: 0.5px;
}

.lang-flyout-options {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.lang-flyout-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  cursor: pointer;
  transition: all var(--transition-fast);
  user-select: none;
}

.lang-flyout-item:hover {
  background: var(--bg-surface-hover);
  border-color: var(--border-focus);
}

.lang-flyout-item.active {
  background: var(--accent-primary);
  border-color: var(--border-focus);
  box-shadow: 0 4px 16px var(--accent-glow);
  transform: scale(1.02);
}

.lang-flyout-code {
  font-size: 15px;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 0.5px;
  min-width: 40px;
}

.lang-flyout-item.active .lang-flyout-code {
  color: #ffffff;
}

.lang-flyout-meta {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.lang-flyout-name {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text-primary);
}

.lang-flyout-item.active .lang-flyout-name {
  color: #ffffff;
}

.lang-flyout-desc {
  font-size: 11px;
  color: var(--text-secondary);
}

.lang-flyout-item.active .lang-flyout-desc {
  color: rgba(255, 255, 255, 0.85);
}

.lang-flyout-check {
  font-size: 14px;
  font-weight: bold;
  color: var(--accent-primary);
  min-width: 14px;
  text-align: right;
}

.lang-flyout-item.active .lang-flyout-check {
  color: #ffffff;
}

.lang-flyout-footer {
  padding-top: 8px;
  border-top: 1px solid var(--border-subtle);
}

.lang-flyout-toggle-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11.5px;
  color: var(--text-secondary);
  cursor: pointer;
  user-select: none;
}

/* Windows 11 Fluent HUD Toast для перемикання мови */
.edu-lang-hud {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.92);
  min-width: 290px;
  background: var(--bg-acrylic-solid);
  border: 1px solid var(--border-highlight);
  border-radius: var(--radius-lg);
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.75);
  z-index: 60000;
  padding: 16px;
  pointer-events: none;
  opacity: 0;
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.edu-lang-hud.visible {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.lang-hud-title {
  font-size: 11.5px;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 12px;
  text-align: center;
}

.lang-hud-options {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.lang-hud-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  transition: all var(--transition-fast);
}

.lang-hud-item.active {
  background: var(--accent-primary);
  border-color: var(--border-focus);
  box-shadow: 0 4px 16px var(--accent-glow);
  transform: scale(1.02);
}

.lang-hud-code {
  font-size: 15px;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 0.5px;
}

.lang-hud-item.active .lang-hud-code {
  color: #ffffff;
}

.lang-hud-meta {
  display: flex;
  flex-direction: column;
}

.lang-hud-name {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text-primary);
}

.lang-hud-item.active .lang-hud-name {
  color: #ffffff;
}

.lang-hud-desc {
  font-size: 11px;
  color: var(--text-secondary);
}

.lang-hud-item.active .lang-hud-desc {
  color: rgba(255, 255, 255, 0.85);
}
